{
  "name": "baseline_logistic_regression",
  "description": "Simple Learned Baseline: L2-Regularized Logistic Regression (Section 3.3)",
  "author": "ExperimentationEngineer",
  "seed": 42,
  "model_type": "LogisticRegression_Standard",
  "hyperparameters": {
